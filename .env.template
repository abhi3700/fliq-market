# [Required in production] Server-side merchant credential used by the Vite/Pages proxy.
UNIFI_API_KEY=

# [Required in production] Public recipient address for UniFi payments.
# Replace this local demo value with the merchant's production wallet address.
MERCHANT_WALLET_ADDRESS=

# [Optional] UniFi admin override for local, staging, or self-hosted API testing.
# Merchants should normally omit it and use the API URL built into the widget.
UNIFI_API_BASE_URL=

# [Optional] local-only override for the UniFi checkout web app.
# Merchants should omit it and use the web app URL built into the widget.
UNIFI_WEB_APP_BASE_URL=
